# Copy to .env.cf (gitignored) and fill. Used only for: npm run setup:d1
# Do NOT put this token in .dev.vars (that file is for Worker runtime secrets).

CLOUDFLARE_API_TOKEN=
# Copy the same value as account_id in wrangler.toml (reduces Wrangler /memberships errors with API tokens):
CLOUDFLARE_ACCOUNT_ID=
